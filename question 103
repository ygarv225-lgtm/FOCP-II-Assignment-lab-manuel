#include<stdio.h>
#include<math.h>
#include<stdlib.h>
#include<limits.h>
#include<string.h>
int main(){
   // counting the vowels and the consonents ratio
   char str1[200];
   int count_v=0;
   int count_c=0;
   printf("enter a name : ");
   scanf("%[^\n]s",str1);
   for(int i=0;str1[i]!='\0';i++){
    if(str1[i]=='a' ||str1[i]=='e' ||str1[i]=='i' ||str1[i]=='o' ||str1[i]=='u') count_c++;
    else count_v++;
   }
   printf("VOWELS : %d\nCONSONENT : %d",count_c,count_v);
   return 0;
}
